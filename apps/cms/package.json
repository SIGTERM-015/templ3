{
  "name": "cms",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "deploy:app": "opennextjs-cloudflare build --skipNextBuild && wrangler deploy",
    "deploy:preview": "opennextjs-cloudflare build --skipNextBuild && wrangler versions upload",
    "cf:deploy": "pnpm run build && pnpm run deploy:app",
    "preview:deploy": "pnpm run deploy:preview",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed.ts",
    "check:migrations": "bash scripts/check-migrations.sh",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "migrate:prod": "node -e \"const { execSync } = require('child_process'); require('dotenv').config(); execSync('pnpm run payload migrate', { env: { ...process.env, DATABASE_URL: process.env.DATABASE_URL_PROD }, stdio: 'inherit' })\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1004.0",
    "@opennextjs/cloudflare": "1.20.8",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-r2": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.8",
    "payload": "3.90.2",
    "payload-totp": "^3.0.6",
    "pg": "^8.20.0",
    "pg-cloudflare": "^1.3.0",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260307.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.9",
    "@types/pg": "^8.18.0",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.4.2",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  }
}
