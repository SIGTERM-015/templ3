---
import Layout from '../../layouts/Layout.astro'
import { getSiteIdentity, getWebApps } from '../../lib/cms'
import { getMediaDetail, getMediaLog } from '../../lib/magpie'
import { parseMediaKey } from '../../lib/mediaLog'

export const prerender = false

const key = parseMediaKey(Astro.params.slug)
if (!key) return Astro.redirect('/media')

const [mediaItem, media, siteIdentity, webApps] = await Promise.all([
  getMediaDetail(key),
  getMediaLog(),
  getSiteIdentity(),
  getWebApps(),
])

if (!mediaItem) return Astro.redirect('/media')
---

<Layout
  title={`${mediaItem.title} | ${siteIdentity?.siteName ?? 'Templ3'}`}
  description={mediaItem.notes || mediaItem.synopsis || `${mediaItem.title} on ${siteIdentity?.siteName ?? 'Templ3'} Media.`}
  ogImage={`/api/og/media/${mediaItem.key}.png`}
  initialApp="media"
  serverData={JSON.stringify({ media, mediaItem, siteIdentity, webApps })}
  maximized={Astro.url.searchParams.has('maximized')}
/>
