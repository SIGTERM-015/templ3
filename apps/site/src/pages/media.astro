---
import Layout from '../layouts/Layout.astro'
import { getSiteIdentity, getWebApps } from '../lib/cms'
import { getMediaLog } from '../lib/magpie'

export const prerender = false

const [media, siteIdentity, webApps] = await Promise.all([
  getMediaLog(),
  getSiteIdentity(),
  getWebApps(),
])
---

<Layout
  title={siteIdentity?.siteName ? `Media | ${siteIdentity.siteName}` : 'Media | Templ3'}
  description="Anime, games, books, and everything Sigterm has watched, read, and played."
  initialApp="media"
  serverData={JSON.stringify({ media, siteIdentity, webApps })}
  maximized={Astro.url.searchParams.has('maximized')}
  ogImage="/api/og/media.png"
/>
