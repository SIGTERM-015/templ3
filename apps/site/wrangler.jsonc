{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "templ3",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-03-07",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client"
	},
	// Branch builds go up with `wrangler versions upload`; without this flag a worker
	// that only has custom-domain routes gets no preview URL.
	"preview_urls": true,
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "sigterm.vodka",
			"custom_domain": true
		},
		{
			"pattern": "www.sigterm.vodka",
			"custom_domain": true
		}
	],
	// Guestbook submissions per signed-in user. Each one writes an image to R2, so cap them.
	"ratelimits": [
		{
			"name": "GUESTBOOK_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 3, "period": 60 }
		}
	],
	"vars": {
		"PUBLIC_CMS_URL": "https://cms.sigterm.vodka",
		"MAGPIE_API_URL": "https://magpie.yellowumbrella.dev",
		"LISTENBRAINZ_USERNAME": "Sigterm015"
	},
	// LISTENBRAINZ_TOKEN (secret, optional) enables cover art for the track that is playing.
	"secrets_store_secrets": []
}
